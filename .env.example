# ==============================================================================
# LeadRescue Environment Variables Template
# Copy this file to .env.local for local development. Never commit .env.local!
# ==============================================================================

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Supabase Auth & PostgreSQL
# Found in Supabase project dashboard -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Server-side ONLY! Never expose service role key to the browser.
SUPABASE_SERVICE_ROLE_KEY=""
DATABASE_URL=""

# Transactional Email (Resend)
RESEND_API_KEY=""
EMAIL_FROM="LeadRescue <notifications@leadrescue.example.com>"

# Billing / Payments (Stripe / LemonSqueezy / Razorpay depending on jurisdiction)
BILLING_PROVIDER="stripe"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_STARTER_PRICE_ID=""
STRIPE_AGENCY_PRICE_ID=""

# AI Provider (Optional Draft Assistance)
AI_PROVIDER="openai" # or "anthropic" / "gemini"
AI_API_KEY=""

CRON_SECRET=""
ADMIN_HEALTH_SECRET=""
EMAIL_TRANSPORT_MODE="mock" # non-production only

# Redis / Rate Limiting (Phase 10/11 - optional initially)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
