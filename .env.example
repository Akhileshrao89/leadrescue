# ==============================================================================
# LeadRescue Environment Variables Template
# Copy this file to .env.local for local development. Never commit .env.local!
# ==============================================================================

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Supabase Auth & PostgreSQL
# Found in Supabase project dashboard -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# Server-side ONLY! Never expose service role key to the browser.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
DATABASE_URL="postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres"

# Transactional Email (Resend)
RESEND_API_KEY="re_123456789"
EMAIL_FROM="LeadRescue <notifications@leadrescue.example.com>"

# Billing / Payments (Stripe / LemonSqueezy / Razorpay depending on jurisdiction)
BILLING_PROVIDER="stripe"
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_STARTER_PRICE_ID="price_starter_..."
STRIPE_AGENCY_PRICE_ID="price_agency_..."

# AI Provider (Optional Draft Assistance)
AI_PROVIDER="openai" # or "anthropic" / "gemini"
AI_API_KEY="sk-..."

# Redis / Rate Limiting (Phase 10/11 - optional initially)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
