# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment files: only the sanitized template may be committed
.env
.env.*
!.env.example
*.local

# Private keys and local credential files
*.key
*.p12
*.pfx
secrets/
credentials/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.firebase
